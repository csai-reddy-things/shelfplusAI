# ==============================================================================
# ShelfPulse AI - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Credentials (DO NOT COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env

# Always allow committing environment template examples
!.env.example
!server/.env.example
!client/.env.example

# ------------------------------------------------------------------------------
# 2. Dependency Directories
# ------------------------------------------------------------------------------
node_modules/
server/node_modules/
client/node_modules/
jspm_packages/
web_modules/

# ------------------------------------------------------------------------------
# 3. Production Builds & Vite Artifacts
# ------------------------------------------------------------------------------
dist/
dist-ssr/
client/dist/
build/
client/build/
.vite/
client/.vite-temp/
*.local

# ------------------------------------------------------------------------------
# 4. Logs & Debugging Output
# ------------------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Operating System Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 6. IDEs & Editor Configuration
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ------------------------------------------------------------------------------
# 7. Temporary / Scratch Scripts & Cache
# ------------------------------------------------------------------------------
.cache/
.parcel-cache/
*.tmp
*.temp
test-*.js
test-*.mjs
