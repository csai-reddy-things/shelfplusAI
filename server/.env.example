PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres URI for node scripts/migrate.js (optional)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Google Gemini API (@google/genai)
GEMINI_API_KEY=your-google-gemini-api-key

# WhatsApp Live Dispatch (Twilio WhatsApp API)
# Note: If Twilio credentials are left blank, the server automatically falls back to DEMO_SIMULATED mode + instant wa.me deep link so the app never crashes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEFAULT_DEMO_WHATSAPP_TO=+919876543210
